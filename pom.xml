<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.lumen</groupId>
    <artifactId>lumen-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        fat-jar profile — activate with: mvn package -Pfat-jar
        Creates a single self-contained JAR with all dependencies and merged
        META-INF/services entries (required for Lumen's SPI module loader).

        In your application pom, add this parent and activate the profile:
            mvn package -Pfat-jar
            java -jar target/my-app-*.jar
    -->
    <profiles>
        <profile>
            <id>fat-jar</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals><goal>shade</goal></goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <!-- Override mainClass in your app pom or pass -DmainClass=... -->
                                            <mainClass>${mainClass}</mainClass>
                                        </transformer>
                                        <!-- Merges all META-INF/services/* files so Lumen SPI modules are discovered -->
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                    </transformers>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <modules>
        <module>lumen-core</module>
        <module>lumen-context</module>
        <module>lumen-web</module>
        <module>lumen-web-thymeleaf</module>
        <module>lumen-web-mvc</module>
        <module>lumen-security</module>
        <module>lumen-aop</module>
        <module>lumen-data</module>
        <module>lumen-boot</module>
        <module>lumen-boot-starter</module>
        <module>lumen-boot-starter-web</module>
        <module>lumen-boot-starter-thymeleaf</module>
        <module>lumen-boot-starter-data-jpa</module>
        <module>lumen-boot-starter-security</module>
        <module>lumen-validation</module>
        <module>lumen-boot-starter-validation</module>
        <module>lumen-cache</module>
        <module>lumen-boot-starter-cache</module>
        <module>lumen-websocket</module>
        <module>lumen-boot-starter-websocket</module>
    </modules>
</project>